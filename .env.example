# Database — SQLite for local; switch prisma provider to postgresql for production
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@host:5432/applypilot?sslmode=require"

# Auth — required in production (32+ random chars)
AUTH_SECRET="replace-with-long-random-secret"

# App
NEXT_PUBLIC_APP_NAME="ApplyPilot"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# AI — required for production-quality generation
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Set REQUIRE_OPENAI=true in production to refuse heuristic fallbacks for paid features
REQUIRE_OPENAI="false"

# Stripe billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_CREDITS_25=""
STRIPE_PRICE_CREDITS_50=""
STRIPE_PRICE_CREDITS_100=""
STRIPE_PRICE_CREDITS_250=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="ApplyPilot <noreply@applypilot.example>"

# Cron / workers — send as Authorization: Bearer <secret>
CRON_SECRET=""

# Optional: allow demo login in non-production only (disabled when NODE_ENV=production)
ALLOW_DEMO_LOGIN="true"
